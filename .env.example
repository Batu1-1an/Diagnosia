# =============================================================================
# Diagnosia - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Supabase (Database & Auth) ---------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your_supabase_anon_key"

# --- Google Gemini AI (Dr.AI Chat Assistant) ---------------------------------
GOOGLE_API_KEY="your_google_api_key"

# --- Flask Session Security -------------------------------------------------
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this invalidates all active sessions.
SECRET_KEY="your_super_secret_key"

# --- Deployment (optional) --------------------------------------------------
# FLASK_ENV="production"       # Set to "production" in production environments
# FLASK_DEBUG="0"              # Disable debug mode in production
# PORT="5000"                  # Server port (default: 5000)
# GUNICORN_WORKERS="4"         # Number of gunicorn worker processes (default: 4)
